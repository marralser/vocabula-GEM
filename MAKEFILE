CC = wcc
CFLAGS = -bt=dos -ml -0 -os -s -w4 -I=GEMBIND/include
GEMLIB = GEMBIND/lib/gembnd-l.lib
GEMMAIN = GEMBIND/samples/main-l.obj
OBJECTS = gem_app.obj lesson.obj stats.obj

all: vocabula.app

gem_app.obj: gem_app.c lesson.h stats.h
	$(CC) $(CFLAGS) -fo=$@ gem_app.c

lesson.obj: lesson.c lesson.h
	$(CC) $(CFLAGS) -fo=$@ lesson.c

stats.obj: stats.c stats.h lesson.h
	$(CC) $(CFLAGS) -fo=$@ stats.c

vocabula.app: $(OBJECTS) $(GEMLIB) $(GEMMAIN)
	wlink system dos option quiet option stack=16384 name vocabula.app file gem_app.obj,lesson.obj,stats.obj,$(GEMMAIN) library $(GEMLIB)

$(GEMLIB):
	@echo Build the OpenGEM bindings first. See BUILDING.TXT.
	@exit 1

$(GEMMAIN):
	@echo Build the OpenGEM bindings and samples first. See BUILDING.TXT.
	@exit 1

clean: .SYMBOLIC
	rm -f *.obj
	rm -f vocabula.app

